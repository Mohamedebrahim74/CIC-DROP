VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Password required to view the admin page at /admin.
# Set this in your deployment's environment variables (e.g. Vercel Project
# Settings > Environment Variables). Do not commit a real password here.
VITE_ADMIN_PASSWORD=choose_a_strong_password_here

# Note: no additional environment variables are needed for the student
# access system — it uses the same VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
# above, plus the allowed_players_schema.sql applied in your Supabase project.
